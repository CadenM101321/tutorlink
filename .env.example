# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Real values go there and in Vercel, never in this file.
#
# NEXT_PUBLIC_ values are bundled into browser code, so anyone can see them.
# Only use that prefix for values that are safe to be public.

# Supabase (Project Settings > API Keys). The publishable key is public by design;
# row-level security controls what it can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Database password, used only by the Supabase CLI on your computer
# (npx supabase link / db push). Never add it to Vercel or use it in app code.
SUPABASE_DB_PASSWORD=
